# xAI (server-side only — never expose in frontend bundles)
XAI_API_KEY=
XAI_TEXT_MODEL=grok-4-1-fast-reasoning
XAI_IMAGE_MODEL=grok-imagine-image-2.0
XAI_VOICE_MODEL=grok-voice-latest
XAI_BASE_URL=https://api.x.ai/v1

# Persistence
DATABASE_URL=sqlite:///./cosmos.db

# Dataset and assets (paths relative to repo root unless absolute)
DATA_DIR=./data
ASSET_DIR=./assets

# Frontend dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SpacetimeDB Maincloud (public read of science tables; no secret required)
VITE_SPACETIME_HOST=https://maincloud.spacetimedb.com
VITE_SPACETIME_DB=cosmicexploration-dejjt

# Optional future ingest tokens
# NASA_EARTHDATA_TOKEN=
# NOAA_TOKEN=
# NCBI_API_KEY=
